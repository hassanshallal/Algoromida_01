@model Contact
<form align="center" asp-controller="Home" asp-action="DeliverContact" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="FullName" style="float:left">Full name</label>
        <input asp-for="FullName" class="form-control" placeholder="Please provide your full name." />
    </div>
    <div class="form-group">
        <label asp-for="Email" style="float:left">Email</label>
        <input asp-for="Email" class="form-control" placeholder="Please provide your email." />
    </div>
    <div class="form-group">
        <label asp-for="Message" style="float:left"> Your message</label>
        <textarea asp-for="Message" class="form-control" placeholder="Please Type your message here."></textarea>
    </div>
    <button type="submit" value="Send" class="btn btn-primary">Send message.</button>
</form>


