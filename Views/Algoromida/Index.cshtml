@model UserBotInteractionViewModel
@{
    ViewData["Title"] = "Now you're talking";
}
<div class="panel panel-default todo-panel">
    <div class="panel-heading">@ViewData["Title"]</div>

    <table class="table table-hover">
        <thead>
            <tr>
                <td>Query</td>
                <td>Response</td>
            </tr>
        </thead>
        <tr>
            <td>@Model.ThisInteraction.UserQuery</td>
            <td>@Model.ThisInteraction.BotResponse.</td>
        </tr>
    </table>
</div>
