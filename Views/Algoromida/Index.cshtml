@model UserBotInteractionViewModel;

    <div class="panel panel-default bots-interaction-panel">
        <div class="panel-heading">@ViewData["Title"]</div>

        @foreach (var interaction in Model.Interactions)
        {

            <p class="userText"><span>@interaction.UserQuery</span></p>
            <p class="botText"><span>@interaction.BotResponse</span></p>

        }

        @if (Model.Interactions.Length > 0)
        {
            <script type="text/javascript">
                        var textToSpeak = "@(Model.Interactions[Model.Interactions.Length - 1].BotResponse)";
                        var utterance = new SpeechSynthesisUtterance(textToSpeak);
                        window.speechSynthesis.speak(utterance);
            </script>
        }
        else
        {
            <script type="text/javascript">
                var textToSpeak = "'Welcome to ' + @Model.BotId";
                var utterance = new SpeechSynthesisUtterance(textToSpeak);
                window.speechSynthesis.speak(utterance);
            </script>
        }

        <div class="panel-footer issue_query_form">
            @{
                UserBotInteraction userBotInteraction = new UserBotInteraction();
                userBotInteraction.BotId = Model.BotId;
            }
            @await Html.PartialAsync("IssueQeuryPartial", userBotInteraction)
        </div>

    </div>

