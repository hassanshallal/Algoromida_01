@model UserBotInteractionViewModel;

@{ ViewData["Title"] = "Messages history with " + Model.BotId + "!"; }

<!-- This is the right part showing detailed message history with active bot in the left part-->
<center>
<!-- this div is for the messages-->
    <div id="chatbox">
        <div id="chatmessages">
            @foreach (var interaction in Model.Interactions)
            {
                string initiatedAt = interaction.InitiatedAt.ToString();
                string initiatedAtTrimmed = initiatedAt.Substring(0, initiatedAt.Length - 6);
                string completedAt = interaction.CompletedAt.ToString();
                string completedAtTrimmed = completedAt.Substring(0, completedAt.Length - 6);


                <!-- use user avatar instead in the img source in received_msg_img-->
                <div class="recieved">
                    <span class="received_msg_img"> <img src="@interaction.UserAvatarPath"></span>
                    <div class="received_msg">
                        <p>
                            @interaction.UserQuery
                        </p>
                        <span class="time_date">@initiatedAtTrimmed</span>
                    </div>
                </div>
                <div class="outgoing">
                    <span class="outgoing_msg_img"> <img src="@interaction.BotAvatarPath"></span>
                    <div class="outgoing_msg">
                        <p>
                            @interaction.BotResponse
                        </p>
                        <span class="time_date">@completedAtTrimmed</span>
                    </div>
                </div>
            }


            @{
                if (Model.Interactions.Length == 0)
                {
                    <script>
                    // This is to welcome a new user

                    function runSpeechWelcome(botName) {
                        var textToSpeak = "Welcome to " + botName;
                        var utterance = new SpeechSynthesisUtterance(textToSpeak);
                        window.speechSynthesis.speak(utterance);
                    };

                    var botName = "@Model.BotId";
                    runSpeechWelcome(botName);
                    </script>
                }
                else
                {
                    DateTimeOffset timeNow = DateTimeOffset.Now;
                    DateTimeOffset lastBotResponse = DateTimeOffset.Now; ;

                    DateTimeOffset? lastBotResponseOffset = Model.Interactions[Model.Interactions.Length - 1].CompletedAt;
                    if (lastBotResponseOffset.HasValue)
                    {
                        lastBotResponse = lastBotResponseOffset.Value;
                        TimeSpan diff = timeNow - lastBotResponse;
                        if (diff.Seconds < 10)
                        {
                            <script>
                                // More options at: https://codepen.io/matt-west/pen/wGzuJ
                                // This is to speak the botResponse
                                function runSpeechSynthesis(lastBotResponse) {
                                    console.log(lastBotResponse); // just for debugging text anomalies
                                    var utterance = new SpeechSynthesisUtterance(lastBotResponse);
                                    window.speechSynthesis.speak(utterance);
                                };

                                var lastBotResponse = "@Model.GetLastBotInteraction()";
                                var lastBotResponse = String(lastBotResponse).replaceAll("&#x27;", "'");
                                var lastBotResponse = String(lastBotResponse).replaceAll("&quot;", "")
                                runSpeechSynthesis(lastBotResponse);
                            </script>
                        }
                    }

                }
            }
        </div>
    </div>
    

    <!-- This div shall use the partial view to interact with a given bot-->
    <div class="panel-footer issue_query_form">
        @{
            UserBotInteraction userBotInteraction = new UserBotInteraction();
            userBotInteraction.BotId = Model.BotId;
        }
        @await Html.PartialAsync("IssueQeuryPartial", userBotInteraction)
    </div>
</center>


    

