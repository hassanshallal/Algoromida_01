@page "/Register"
@using Algoromida_01.Areas.Identity.Pages.Account
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<form asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data">
    <h4>Create a new account.</h4>
    <hr />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row">
        <div class="col">
            <div class="form-group" style="">
                <label asp-for="Input.FirstName"></label>
                <input asp-for="Input.FirstName" class="form-control" />
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>
        </div>
        <div class="col">
            <div class="form-group">
                <label asp-for="Input.LastName"></label>
                <input asp-for="Input.LastName" class="form-control" />
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>
        </div>
        <div class="col">
            <div class="form-group">
                <script type="text/javascript" src="~/js/countries_gender.js"></script>
                <label asp-for="Input.Gender">Gender</label>
                <select id="gender"  asp-for="Input.Gender" class="form-control"></select>
                <script language="javascript">populateGender("gender");</script>
                <span asp-validation-for="Input.Gender" class="text-danger"></span>
            </div>
        </div>
        <div class="col">
            <div class="form-group">
                <label asp-for="Input.DOB"></label>
                <input asp-for="Input.DOB" class="form-control" />
                <span asp-validation-for="Input.DOB" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="form-group">
                <label asp-for="Input.TimeZone"></label>
                <input asp-for="Input.TimeZone" class="form-control" id="tz" />
                <script>document.getElementById("tz").value = Date().toString().split("GMT")[1].split(" (")[0].replace(/0/g, "");</script>
                <span asp-validation-for="Input.TimeZone" class="text-danger"></span>
            </div>
        </div>
        <div class="col">
            <div class="form-group">
                <script type="text/javascript" src="~/js/countries_gender.js"></script>
                <label asp-for="Input.Country">Country</label>
                <select id="country" asp-for="Input.Country" class="form-control"></select>
                <script language="javascript">populateCountries("country", "state");</script>
                <span asp-validation-for="Input.Country" class="text-danger"></span>
            </div>
        </div>
        <div class="col">
            <div class="form-group">
                <script type="text/javascript" src="~/js/countries_gender.js"></script>
                <label asp-for="Input.State">State</label>
                <select id="state" asp-for="Input.State" class="form-control"></select>
                <script language="javascript">populateCountries("country", "state");</script>
                <span asp-validation-for="Input.State" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="form-group">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
        </div>
        <div class="col">
            <div class="form-group">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">

        <div class="col">
            <div class="form-group">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
        </div>
        <div class="col">
            <div class="form-group">
                <label asp-for="Input.AvatarPath">Please upload an avatar (Image less than 2MB)</label>
                <input type="file" name="fromFile" class="form-control" />
                <span asp-validation-for="Input.AvatarPath" class="text-danger"></span>
            </div>
        </div>
    </div>
    <button type="submit" class="button" style="color: #E8DF00;background-color: #0D0D0D;border-color: #0D0D0D">Register</button>
</form>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
